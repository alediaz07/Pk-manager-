# ==============================================================================
# POLLOS KAREN MANAGER — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copie este archivo a .env (solo local) o configure estas variables en el
#    panel seguro de secretos de su plataforma (AI Studio / Cloud Run / Hosting).
# 2. NUNCA coloque claves reales en este archivo ni en el repositorio Git.
# 3. NUNCA exponga secretos privados con el prefijo VITE_.
# ==============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Lista separada por comas de orígenes permitidos por CORS en producción
# Ejemplo: ALLOWED_ORIGINS="https://polloskaren.web.app,https://pos.polloskaren.cr"
ALLOWED_ORIGINS=""

# --- Inteligencia Artificial (SOLO SERVIDOR — PRIVADO) ---
# Clave de Gemini API para escaneo efímero de facturas de compra.
GEMINI_API_KEY="REEMPLAZAR_CON_CLAVE_PRIVADA_GEMINI"

# Clave secreta de mínimo 32 caracteres aleatorios para el asistente Jarvis / ChatGPT (solo lectura).
# Generar con: openssl rand -hex 32
JARVIS_API_KEY="REEMPLAZAR_CON_CLAVE_SECRETA_MIN_32_CHARS"

# --- Administración Bootstrap (Opcional — Respaldo de emergencia) ---
# Correo verificado del administrador principal de respaldo (complementa la colección /admins/{uid}).
PRIMARY_ADMIN_EMAIL="admin@ejemplo.com"
